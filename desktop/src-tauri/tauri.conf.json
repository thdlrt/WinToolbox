{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinToolbox",
  "version": "0.1.23",
  "identifier": "com.wintoolbox.desktop",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {
    "windows": [{"label":"main","title":"WinToolbox","width":1280,"height":860,"minWidth":940,"minHeight":640,"center":true}],
    "security": {"csp":"default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'", "capabilities":[{"identifier":"desktop","windows":["main","overlay","captions","orb"],"permissions":["core:default","core:window:allow-start-dragging","core:window:allow-start-resize-dragging"]}]}
  },
  "bundle": {
    "active":true,"targets":["nsis"],"category":"Productivity","shortDescription":"可扩展的本地语音与效率工具箱",
    "icon":["icons/icon.ico","icons/32x32.png","icons/128x128.png"],
    "resources":{"resources/core/":"core/","resources/python/":"python/","resources/tools/":"tools/"},
    "windows":{"allowDowngrades":false,"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"installerHooks":"windows/relay-hooks.nsh","compression":"zlib","installMode":"currentUser","languages":["SimpChinese"],"displayLanguageSelector":false,"startMenuFolder":"WinToolbox"}}
  }
}
